<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application" x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage" Title="Logradouros" BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#101820}">
    <ContentPage.Resources><Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#071B33, Dark=White}"/></Style></ContentPage.Resources>
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="← Voltar ao início" BackgroundColor="{AppThemeBinding Light=#E1E6ED, Dark=#334155}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}" Command="{Binding VoltarInicioCommand}" />
            <Button Grid.Column="1" Text="✚ Novo Logradouro" Command="{Binding NovoCommand}" />
        </Grid>
        <SearchBar Grid.Row="1" Placeholder="Digite o nome do logradouro ou da cidade para buscar" Text="{Binding Busca}" SearchCommand="{Binding CarregarCommand}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Logradouros}" SelectionMode="None"><CollectionView.EmptyView><Label Text="Nenhum logradouro encontrado." HorizontalOptions="Center" Margin="0,40"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="dto:LogradouroDto"><Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E1E6ED, Dark=#475569}" StrokeShape="RoundRectangle 14" Margin="0,6" Padding="14"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#071B33, Dark=White}"/><Label Grid.Row="1" Text="{Binding Bairro, StringFormat='Bairro: {0}'}" TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/><Label Grid.Row="2" Text="{Binding Cidade, StringFormat='Cidade: {0}'}" TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/><VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="8"><Button Text="✎ Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}" CommandParameter="{Binding}"/><Button Text="⌫ Excluir" BackgroundColor="#B42318" TextColor="White" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}" CommandParameter="{Binding}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </Grid>
</ContentPage>
