<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application" x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage" Title="Logradouros" BackgroundColor="#F7F8FA">
    <ContentPage.Resources><Style TargetType="Label"><Setter Property="TextColor" Value="#071B33"/></Style></ContentPage.Resources>
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="← Voltar ao início" BackgroundColor="#E1E6ED" TextColor="#071B33" Command="{Binding VoltarInicioCommand}" />
            <Button Grid.Column="1" Text="+ Novo Logradouro" Command="{Binding NovoCommand}" />
        </Grid>
        <SearchBar Grid.Row="1" Placeholder="Digite o nome do logradouro ou da cidade para buscar" Text="{Binding Busca}" SearchCommand="{Binding CarregarCommand}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Logradouros}" SelectionMode="None"><CollectionView.EmptyView><Label Text="Nenhum logradouro encontrado." HorizontalOptions="Center" Margin="0,40"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="dto:LogradouroDto"><Border BackgroundColor="White" Stroke="#E1E6ED" StrokeShape="RoundRectangle 14" Margin="0,6" Padding="14"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="#071B33"/><Label Grid.Row="1" Text="{Binding Bairro, StringFormat='Bairro: {0}'}" TextColor="#45546A"/><Label Grid.Row="2" Text="{Binding Cidade, StringFormat='Cidade: {0}'}" TextColor="#45546A"/><VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="8"><Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}" CommandParameter="{Binding}"/><Button Text="Excluir" BackgroundColor="#B42318" TextColor="White" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}" CommandParameter="{Binding}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </Grid>
</ContentPage>
