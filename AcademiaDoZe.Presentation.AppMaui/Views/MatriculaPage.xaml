<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:conv="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters" x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaPage" Title="Matrícula" BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#101820}">
    <ContentPage.Resources><conv:EnumDisplayConverter x:Key="EnumDisplay"/><conv:DateOnlyToDateTimeConverter x:Key="DateOnly"/><conv:FotoToImageSourceConverter x:Key="Foto"/><Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#071B33, Dark=White}"/></Style></ContentPage.Resources>
    <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='16,20', Desktop='32,28'}" Spacing="10" MaximumWidthRequest="900" HorizontalOptions="Center">
        <Label Text="Nova Matrícula" FontSize="28" FontAttributes="Bold"/><Label Text="Selecione o aluno e configure o plano." TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/>
        <Label Text="Aluno *"/><Picker Title="Selecione um aluno cadastrado" ItemsSource="{Binding Alunos}" ItemDisplayBinding="{Binding Nome}" SelectedItem="{Binding AlunoSelecionado}"/>
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E1E6ED, Dark=#475569}" StrokeShape="RoundRectangle 12" Padding="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Image Source="{Binding AlunoSelecionado.Foto, Converter={StaticResource Foto}}" WidthRequest="70" HeightRequest="70" Aspect="AspectFill"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding AlunoSelecionado.Nome, TargetNullValue='Nenhum aluno selecionado'}" FontAttributes="Bold"/><Label Text="{Binding AlunoSelecionado.Cpf, StringFormat='CPF: {0}'}"/><Label Text="{Binding AlunoSelecionado.DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}"/></VerticalStackLayout></Grid></Border>
        <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,*'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}" ColumnSpacing="12" RowSpacing="10"><VerticalStackLayout><Label Text="Plano *"/><Picker ItemsSource="{Binding Planos}" SelectedItem="{Binding PlanoSelecionado}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplay}}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Desktop=1}" Grid.Row="{OnIdiom Phone=1, Desktop=0}"><Label Text="Início *"/><DatePicker Date="{Binding DataInicioSelecionada}"/></VerticalStackLayout></Grid>
        <Label Text="Data final calculada automaticamente"/><DatePicker Date="{Binding DataFimCalculada}" IsEnabled="False"/>
        <Label Text="Objetivo *"/><Editor Placeholder="Ex.: condicionamento físico e ganho de massa" AutoSize="TextChanges" Text="{Binding Matricula.Objetivo}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}"/>
        <Label Text="Restrições médicas" FontAttributes="Bold" Margin="0,10,0,0"/>
        <VerticalStackLayout Spacing="8" Padding="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding Diabetes}"/><Label Text="Diabetes" VerticalOptions="Center"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding PressaoAlta}"/><Label Text="Pressão alta" VerticalOptions="Center"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding Labirintite}"/><Label Text="Labirintite" VerticalOptions="Center"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding Alergias}"/><Label Text="Alergias" VerticalOptions="Center"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding ProblemasRespiratorios}"/><Label Text="Problemas respiratórios" VerticalOptions="Center"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding RemedioContinuo}"/><Label Text="Remédio contínuo" VerticalOptions="Center"/></HorizontalStackLayout>
        </VerticalStackLayout>
        <Label Text="Observações sobre restrições"/><Editor Placeholder="Descreva as observações, se necessário" AutoSize="TextChanges" Text="{Binding Matricula.ObservacoesRestricoes}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}"/>
        <Label Text="Laudo médico (obrigatório para aluno menor de 16 anos ou com restrições)"/><Button Text="▣ Selecionar laudo" Command="{Binding SelecionarLaudoCommand}"/><Label Text="{Binding NomeLaudo}" FontSize="12" TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/>
        <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,*'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}" ColumnSpacing="12" RowSpacing="10" Margin="0,12,0,0"><Button Text="Salvar matrícula" Command="{Binding SalvarCommand}"/><Button Grid.Column="{OnIdiom Phone=0, Desktop=1}" Grid.Row="{OnIdiom Phone=1, Desktop=0}" Text="Cancelar" Command="{Binding CancelarCommand}" BackgroundColor="{AppThemeBinding Light=#E1E6ED, Dark=#334155}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}"/></Grid>
    </VerticalStackLayout></ScrollView>
</ContentPage>
