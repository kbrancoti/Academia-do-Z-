<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application" xmlns:conv="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters" x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage" Title="Colaboradores" BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#101820}">
    <ContentPage.Resources><conv:EnumDisplayConverter x:Key="EnumDisplay"/><Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#071B33, Dark=White}"/></Style></ContentPage.Resources>
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="← Início" BackgroundColor="{AppThemeBinding Light=#E1E6ED, Dark=#334155}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}" Command="{Binding VoltarInicioCommand}"/><Button Grid.Column="1" Text="✚ Novo colaborador" Command="{Binding NovoCommand}"/></Grid>
        <SearchBar Grid.Row="1" Placeholder="Busque por nome, CPF ou e-mail" Text="{Binding Busca}" SearchCommand="{Binding CarregarCommand}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Colaboradores}" SelectionMode="None"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical"><GridItemsLayout.Span><OnIdiom x:TypeArguments="x:Int32" Phone="1" Tablet="2" Desktop="2" Default="1"/></GridItemsLayout.Span></GridItemsLayout></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="Nenhum colaborador encontrado." HorizontalOptions="Center" Margin="0,40"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="dto:ColaboradorDto"><Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E1E6ED, Dark=#475569}" StrokeShape="RoundRectangle 14" Margin="5" Padding="14"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18"/><Label Grid.Row="1" Text="{Binding Tipo, Converter={StaticResource EnumDisplay}}" TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/><Label Grid.Row="2" Text="{Binding Cpf, StringFormat='CPF: {0}'}" TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/><VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="6"><Button Text="✎" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}" CommandParameter="{Binding}"/><Button Text="⌫" BackgroundColor="#B42318" TextColor="White" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}" CommandParameter="{Binding}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </Grid>
</ContentPage>
