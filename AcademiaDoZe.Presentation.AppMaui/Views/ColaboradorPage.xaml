<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:conv="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters" x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorPage" Title="Colaborador" BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#101820}">
    <ContentPage.Resources><conv:DateOnlyToDateTimeConverter x:Key="DateOnly"/><conv:FotoToImageSourceConverter x:Key="Foto"/><conv:EnumDisplayConverter x:Key="EnumDisplay"/><Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#071B33, Dark=White}"/></Style></ContentPage.Resources>
    <ScrollView><VerticalStackLayout Padding="24" Spacing="10" MaximumWidthRequest="900" HorizontalOptions="Center">
        <Label Text="Dados do Colaborador" FontSize="28" FontAttributes="Bold"/><Label Text="Campos com * são obrigatórios." TextColor="{AppThemeBinding Light=#45546A, Dark=#CBD5E1}"/>
        <Image Source="{Binding Colaborador.Foto, Converter={StaticResource Foto}}" HeightRequest="{OnIdiom Phone=120, Desktop=170}" WidthRequest="{OnIdiom Phone=120, Desktop=170}" Aspect="AspectFill" HorizontalOptions="Center" BackgroundColor="{AppThemeBinding Light=#E1E6ED, Dark=#334155}"/><Button Text="▣ Escolher foto (galeria ou câmera)" Command="{Binding SelecionarFotoCommand}"/>
        <Label Text="Nome completo *"/><Entry Placeholder="Ex.: Zé dos testes" Text="{Binding Colaborador.Nome}"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="CPF *"/><Entry Placeholder="Somente números" Keyboard="Numeric" Text="{Binding Colaborador.Cpf}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Nascimento *"/><DatePicker Date="{Binding Colaborador.DataNascimento, Converter={StaticResource DateOnly}, Mode=TwoWay}"/></VerticalStackLayout></Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Telefone *"/><Entry Placeholder="DDD + número" Keyboard="Telephone" Text="{Binding Colaborador.Telefone}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="E-mail"/><Entry Placeholder="nome@exemplo.com" Keyboard="Email" Text="{Binding Colaborador.Email}"/></VerticalStackLayout></Grid>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Admissão *"/><DatePicker Date="{Binding Colaborador.DataAdmissao, Converter={StaticResource DateOnly}, Mode=TwoWay}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Tipo *"/><Picker ItemsSource="{Binding Tipos}" SelectedItem="{Binding Colaborador.Tipo}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplay}}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="Vínculo *"/><Picker ItemsSource="{Binding Vinculos}" SelectedItem="{Binding Colaborador.Vinculo}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplay}}"/></VerticalStackLayout></Grid>
        <Label Text="Endereço (busque um CEP já cadastrado)" FontAttributes="Bold" Margin="0,10,0,0"/><Grid ColumnDefinitions="*,Auto"><Entry Placeholder="CEP: 00000000" Keyboard="Numeric" Text="{Binding Colaborador.Endereco.Cep}"/><Button Grid.Column="1" Text="Buscar CEP" Command="{Binding BuscarCepCommand}"/></Grid>
        <Label Text="Logradouro"/><Entry IsReadOnly="True" Text="{Binding Colaborador.Endereco.Nome}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Número *"/><Entry Placeholder="Ex.: 123" Text="{Binding Colaborador.Numero}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Complemento"/><Entry Placeholder="Apartamento, casa..." Text="{Binding Colaborador.Complemento}"/></VerticalStackLayout></Grid>
        <Label Text="Bairro / Cidade"/><Entry IsReadOnly="True" Text="{Binding Colaborador.Endereco.Bairro}"/><Entry IsReadOnly="True" Text="{Binding Colaborador.Endereco.Cidade}"/>
        <Label Text="Senha (opcional ao editar)"/><Entry Placeholder="Crie uma senha" IsPassword="True" Text="{Binding Colaborador.Senha}"/><Label Text="Confirmar senha"/><Entry Placeholder="Repita a senha" IsPassword="True" Text="{Binding ConfirmarSenha}"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0"><Button Text="Salvar" Command="{Binding SalvarCommand}"/><Button Grid.Column="1" Text="Cancelar" BackgroundColor="{AppThemeBinding Light=#E1E6ED, Dark=#334155}" TextColor="{AppThemeBinding Light=#071B33, Dark=White}" Command="{Binding CancelarCommand}"/></Grid>
    </VerticalStackLayout></ScrollView>
</ContentPage>
