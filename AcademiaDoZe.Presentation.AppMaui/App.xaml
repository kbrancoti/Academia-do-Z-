<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AcademiaDoZe.Presentation.AppMaui.App">
    <Application.Resources>
        <Color x:Key="Primary">#D4A72C</Color><Color x:Key="Navy">#071B33</Color><Color x:Key="Surface">#F7F8FA</Color>
        <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="#071B33"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="Padding" Value="16,12"/></Style>
        <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="White"/><Setter Property="TextColor" Value="#071B33"/><Setter Property="PlaceholderColor" Value="#667085"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="SearchBar"><Setter Property="BackgroundColor" Value="White"/><Setter Property="TextColor" Value="#071B33"/><Setter Property="PlaceholderColor" Value="#667085"/></Style>
    </Application.Resources>
</Application>
